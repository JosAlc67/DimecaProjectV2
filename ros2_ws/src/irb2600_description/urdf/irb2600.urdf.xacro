<?xml version="1.0"?>
<robot name="abb_irb2600_coating_cell" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="world"/>

  <!-- Included macros -->
  <xacro:include filename="$(find irb2600_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find irb2600_description)/urdf/irb2600_macro.xacro"/>
  <xacro:include filename="$(find irb2600_description)/urdf/robot_base.xacro"/>
  <xacro:include filename="$(find irb2600_description)/urdf/spray_nozzle.xacro"/>
  <xacro:include filename="$(find irb2600_description)/urdf/ros2_control.xacro"/>

  <!-- Track and Platform Links -->
  <link name="track_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://irb2600_coating_cell/meshes/Riel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pedestal_coral"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://irb2600_coating_cell/meshes/Riel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="500.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <link name="platform_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://irb2600_coating_cell/meshes/PlataformaRiel.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pedestal_coral"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://irb2600_coating_cell/meshes/PlataformaRiel.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Joints connecting World -> Track -> Platform -->
  <!-- Assume the track lies flat on the ground. We might need to adjust RPY if the STL Z is the length -->
  <!-- The user said Z is 8610, which means the track is aligned with Z. If it should be horizontal (Y axis), we rotate it. -->
  <!-- Let's keep it as is first, we can view it in RViz later. -->
  <joint name="world_to_track_joint" type="fixed">
    <parent link="world"/>
    <child link="track_link"/>
    <!-- Rotate 180 around Z to put cables on the back. Shift Y by -4.3 to center the 8.6m track at world origin -->
    <origin xyz="0 -4.3 0" rpy="1.5708 0 3.14159265359"/>
  </joint>

  <!-- Prismatic joint for the linear track -->
  <joint name="track_prismatic_joint" type="prismatic">
    <parent link="track_link"/>
    <child link="platform_link"/>
    <!-- Center the carriage on the track rails -->
    <origin xyz="-0.0725 0.25 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- The physical track limits. Since we rotated it, +Z moves along world -Y -->
    <limit lower="0.0" upper="4.5" effort="1000.0" velocity="1.0"/>
  </joint>

  <!-- Load target panel mesh -->
  <link name="target_panel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://irb2600_coating_cell/meshes/curved_panel.stl"/>
      </geometry>
      <material name="panel_grey">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://irb2600_coating_cell/meshes/curved_panel.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Mount target panel to world at the center of the track reach -->
  <joint name="world_to_target_panel" type="fixed">
    <parent link="world"/>
    <child link="target_panel"/>
    <origin xyz="0.6 -1.2 1.0" rpy="0 0 0"/>
  </joint>

  <!-- Load robot -->
  <xacro:abb_irb2600 prefix=""/>
  <xacro:abb_irb2600_ros2_control prefix=""/>

</robot>
