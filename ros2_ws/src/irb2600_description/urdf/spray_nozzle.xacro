<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Cobra spraying-nozzle end effector.  Its visual mesh comes from the
    supplied Cobra CAD export.  The collision geometry is deliberately a
    conservative box derived from that export's bounds, so MoveIt does not
    need to process the high-detail presentation mesh on every plan.

    Frames:
      tool0            - ROS-Industrial flange-facing frame (from irb2600_macro.xacro)
      spray_nozzle_link - visual/collision body of the nozzle
      nozzle_tip        - TCP frame used as x_e in the preliminary mathematical model
                           (report Sec. VII-B/VII-G). Its Z axis is the tool approach
                           vector z_e that must align with the surface normal n_s
                           within theta_error <= 10 deg (Table VIII), and its distance
                           to the target surface is d_standoff in [0.15, 0.25] m
                           (Table VIII). Those checks are done at planning time, not
                           encoded as a fixed offset here.
  -->
  <!--
    Note: does NOT xacro:include materials.xacro here; it must be included
    exactly once by whichever top-level file assembles the robot (see
    irb2600.urdf.xacro), otherwise urdfdom rejects the duplicated
    'abb_orange' material definition. This file only uses the
    material_abb_orange macro, assuming it is already defined.
  -->

  <!-- Calibration inputs. Defaults preserve the prior digital model; replace
       them with the measured tool0-to-Cobra and tool0-to-TCP transforms. -->
  <xacro:arg name="cobra_mount_xyz" default="0.054 -0.056 0"/>
  <xacro:arg name="cobra_mount_rpy" default="0 -1.5708 0"/>
  <xacro:arg name="cobra_tcp_xyz" default="0 0 0.35"/>
  <xacro:arg name="cobra_tcp_rpy" default="0 0 0"/>

  <link name="spray_nozzle_link">
    <inertial>
      <origin xyz="8.65924565893986E-05 0.0195599698345866 1.93283795397848E-10" rpy="0 0 0"/>
      <mass value="0.0453532792285496"/>
      <inertia
        ixx="0.000055032" ixy="0.000000016" ixz="0"
        iyy="0.000014893" iyz="0" izz="0.000054929"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://irb2600_coating_cell/meshes/cad/cobra_final.stl"/>
      </geometry>
      <xacro:material_abb_orange/>
    </visual>
    <collision>
      <!-- Final Cobra assembly STL bounds in metres:
           342.479 x 315.413 x 108.000. The box center is expressed in the
           STL frame and envelopes the complete assembly. -->
      <origin xyz="-0.115471 -0.122706 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.342479 0.315413 0.108000"/>
      </geometry>
    </collision>
  </link>

  <joint name="tool0_to_spray_nozzle" type="fixed">
    <parent link="tool0"/>
    <child link="spray_nozzle_link"/>
    <!-- Provisional calibration; replace with the measured mounting transform. -->
    <origin xyz="$(arg cobra_mount_xyz)" rpy="$(arg cobra_mount_rpy)"/>
  </joint>

  <!-- TCP: x_e in the preliminary mathematical model (report eq. 1-2, 8-9) -->
  <!-- Coordinate-only link: deliberately has no visual/collision geometry. -->
  <link name="nozzle_tip"/>

  <joint name="tool0_to_nozzle_tip" type="fixed">
    <origin xyz="$(arg cobra_tcp_xyz)" rpy="$(arg cobra_tcp_rpy)"/>
    <parent link="tool0"/>
    <child link="nozzle_tip"/>
  </joint>

</robot>
